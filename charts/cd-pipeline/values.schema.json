{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "cd-pipeline",
  "description": "A Kargo delivery pipeline per project. Strict throughout: a key the chart does not read is refused rather than ignored, because a typo in a value that decides what is promoted renders cleanly and promotes the wrong thing. With no projects nothing is rendered.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Labels on every object. None by default: the chart adds nothing the values do not say."
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations on every object, beside the sync-wave. None by default."
    },
    "waves": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "integer"
        },
        "warehouse": {
          "type": "integer"
        },
        "credentials": {
          "type": "integer"
        },
        "config": {
          "type": "integer"
        },
        "stage": {
          "type": "integer"
        }
      },
      "description": "The Argo CD sync-wave of each kind of object."
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "description": "Where the Argo CD Applications of the Stages live."
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repoURL": {
          "type": "string",
          "minLength": 1,
          "description": "The repository a promotion writes the pin to."
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string",
              "minLength": 1,
              "description": "The Secret each project namespace gets (default `kargo-git-writeback`)."
            },
            "refreshInterval": {
              "type": "string",
              "minLength": 1
            },
            "secretStoreRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "SecretStore",
                    "ClusterSecretStore"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "name"
              ]
            },
            "remoteKey": {
              "type": "string",
              "minLength": 1,
              "description": "The key in the store that holds the GitHub App's credentials."
            },
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "appID": {
                  "type": "string",
                  "minLength": 1
                },
                "installationID": {
                  "type": "string",
                  "minLength": 1
                },
                "privateKey": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "appID",
                "installationID",
                "privateKey"
              ],
              "description": "The property of that key each credential is read from."
            }
          },
          "required": [
            "secretStoreRef",
            "remoteKey",
            "properties"
          ],
          "description": "An ExternalSecret in each project namespace that produces the git credentials Kargo writes back with (a GitHub App)."
        }
      },
      "description": "Where promotions write."
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "pinFile": {
          "type": "string",
          "minLength": 1,
          "description": "The file the pin is written to, relative to the repository; tokens {stage}, {project}, {slug}, {pinKey}."
        },
        "pinKey": {
          "type": "string",
          "minLength": 1,
          "description": "The key written in it; the same tokens."
        },
        "commitMessage": {
          "type": "string",
          "minLength": 1,
          "description": "The same tokens and {version}, the Kargo expression for the promoted version."
        },
        "prTitle": {
          "type": "string",
          "minLength": 1,
          "description": "The same tokens."
        },
        "prLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "errorThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeout": {
              "type": "string",
              "minLength": 1,
              "pattern": "^([0-9]+h[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]s)$"
            }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": {
              "type": "string",
              "minLength": 1,
              "pattern": "^([0-9]+h[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]s)$"
            }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "headroomSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "What every verification Job is run as."
    },
    "promotedVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "An image with a shell and curl."
        },
        "jqImage": {
          "type": "string",
          "minLength": 1,
          "description": "An image holding /jq, mounted as an image volume."
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "script": {
          "type": "string",
          "description": "Replaces the script the chart ships."
        },
        "gateImage": {
          "type": "string",
          "description": "The promotion-gate image (ghcr.io/truvity/cd/promotion-gate). Set: the promoted-version check runs its Go check, `/ko-app/promotion-gate promoted-version`, with no script ConfigMap and no jq volume, and needs neither `image` nor `jqImage`. Empty (the default): the shell script."
        }
      },
      "description": "The built-in promoted-version check."
    },
    "metricsGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gateImage": {
          "type": "string",
          "description": "The promotion-gate image (ghcr.io/truvity/cd/promotion-gate). Set: the gate runs `/ko-app/promotion-gate metrics-gate`, with no script ConfigMap and no jq volume. Empty (the default): the shell script."
        },
        "image": {
          "type": "string",
          "description": "An image with a shell and curl; default promotedVersion.image."
        },
        "jqImage": {
          "type": "string",
          "description": "An image holding /jq, mounted as an image volume; default promotedVersion.jqImage."
        },
        "serviceAccount": {
          "type": "string",
          "minLength": 1,
          "description": "The ServiceAccount the Job runs as; tokens {stage}, {slug}, {project}."
        },
        "issuerHost": {
          "type": "string",
          "description": "The host of the issuer the Job exchanges its ServiceAccount token at (`https://<host>/token`)."
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The query endpoint's base URL; queries go to <url>/api/v1/query."
              },
              "caBundle": {
                "type": "boolean",
                "description": "Verify the endpoint with caBundle's root (mounted, and passed as CA_BUNDLE)."
              }
            },
            "required": [
              "url"
            ]
          },
          "description": "Stage name -> the endpoint the gate of that Stage reads."
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "audience": {
              "type": "string",
              "description": "The audience the projected ServiceAccount token is minted for."
            },
            "expirationSeconds": {
              "type": "integer",
              "minimum": 600
            },
            "volumeName": {
              "type": "string",
              "minLength": 1
            },
            "mountPath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": {
              "type": "string",
              "description": "The ConfigMap holding the root."
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "volumeName": {
              "type": "string",
              "minLength": 1
            },
            "mountPath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "phase1Seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "How long to wait for the promoted version to be the only one serving."
        },
        "bakeSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "How long, from the ready point, the bake may take to collect minJourneys clean samples."
        },
        "scrapeLagSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "minJourneys": {
          "type": "integer",
          "minimum": 1
        },
        "maxFailureRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checkFiringAlerts": {
          "type": "boolean"
        },
        "proberJourneyMetric": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "The built-in metrics gate."
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstreams": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Stage -> the Stages it may promote from, in preference; the first the project has wins."
        },
        "applicationName": {
          "type": "string",
          "minLength": 1,
          "description": "The Argo CD Application a derived Stage watches; tokens {stage}, {app}."
        },
        "promotedVersion": {
          "type": "boolean",
          "description": "Every derived Stage runs the promoted-version check."
        },
        "approvers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "claims": {
              "type": "object",
              "description": "The claims of each approver subject; tokens {stage}, {slug}, {project} in every string."
            }
          }
        },
        "admins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "claims": {
              "type": "object",
              "description": "The claims of the admin subject; tokens {slug}, {project} in every string."
            }
          }
        }
      },
      "description": "The promotion graph a project with `stageOrder` derives its Stages and access from."
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccount": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "bindingName": {
          "type": "string",
          "minLength": 1
        },
        "global": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claims": {
              "type": "object"
            }
          },
          "required": [
            "claims"
          ],
          "description": "Also render the namespace and the ServiceAccount that carries these claims."
        }
      },
      "description": "Read access for every user the ServiceAccount's claims match: a RoleBinding in each project."
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The Project, its namespace and, unless `warehouse.name` says otherwise, its Warehouse. Renaming one deletes it and the Freight history it holds."
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "description": "Names the checks and fills {slug}; default the project's name."
          },
          "pinKey": {
            "type": "string",
            "minLength": 1,
            "description": "Fills {pinKey}: the key the promoted version is written under."
          },
          "chart": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repoURL": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The chart's name in an index repository; none for an OCI one."
              },
              "semver": {
                "type": "string",
                "minLength": 1
              },
              "versionPrefix": {
                "type": "string",
                "description": "Written in front of the version in the pin, for a repository whose tags carry one."
              },
              "discoveryLimit": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "repoURL",
              "semver"
            ],
            "description": "The chart this project delivers; the Warehouse subscribes to it."
          },
          "warehouse": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "interval": {
                "type": "string",
                "minLength": 1,
                "pattern": "^([0-9]+h[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]s)$"
              },
              "freightCreationPolicy": {
                "type": "string",
                "enum": [
                  "Automatic",
                  "Manual"
                ]
              },
              "subscriptions": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "Replaces the chart subscription, verbatim."
              }
            }
          },
          "access": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subjects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claims": {
                      "type": "object",
                      "description": "The OIDC claims a token must carry; Kargo maps a matching token to this ServiceAccount."
                    },
                    "stages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "approve": {
                      "type": "boolean",
                      "description": "May also approve Freight, which Kargo scopes to the whole project."
                    }
                  },
                  "required": [
                    "name",
                    "claims",
                    "stages"
                  ]
                }
              },
              "approvers": {
                "type": "boolean",
                "description": "Derive one approver subject per Stage after the first (graph.approvers); needs stageOrder."
              },
              "admins": {
                "type": "boolean",
                "description": "Derive one admin subject that promotes every Stage and approves (graph.admins); needs stageOrder."
              }
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Stage's name, and the name the access rules and `from` refer to it by."
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Stage whose verified Freight this Stage promotes. Absent: the Stage takes Freight straight from the Warehouse (the project's first)."
                },
                "autoPromote": {
                  "type": "boolean",
                  "description": "Promote new Freight without waiting for a person."
                },
                "applications": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "The Argo CD Applications this Stage deploys, by name. A Stage that promotes from this one waits for them to be Healthy and Synced; its own promoted-version check reads them."
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "pr",
                    "direct"
                  ],
                  "description": "How the pin reaches the repository: a pull request that must merge (default when the Stage has an upstream) or a push to the branch (default for the first Stage)."
                },
                "verification": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "promotedVersion": {
                      "type": "boolean",
                      "description": "Verify that the Stage's Applications render the promoted chart version (needs `applications`, and `promotedVersion.gateImage` or `promotedVersion.image` and `.jqImage`)."
                    },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Name of the AnalysisTemplate."
                          },
                          "metric": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Name of the one metric the template measures (default `check`)."
                          },
                          "args": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "description": "The AnalysisTemplate's argument names; default `[chart-version]`, the version the Stage's Freight promoted."
                          },
                          "serviceAccount": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The ServiceAccount the Job runs as."
                          },
                          "createServiceAccount": {
                            "type": "boolean",
                            "description": "Render the ServiceAccount (default true); false when it exists elsewhere."
                          },
                          "image": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The image the check runs."
                          },
                          "command": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "script": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "configMap": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Name of the ConfigMap that holds the script."
                              },
                              "file": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Key and file name of the script (default `verify.sh`)."
                              },
                              "content": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "configMap",
                              "content"
                            ],
                            "description": "A script mounted read-only at /scripts. With no `command`, it is run with /bin/sh."
                          },
                          "env": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "value": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "name",
                                "value"
                              ]
                            },
                            "description": "Values are strings. Argo Rollouts substitutes `{{args.<name>}}` in them."
                          },
                          "volumes": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            },
                            "description": "Pod volumes, verbatim, after the script's."
                          },
                          "volumeMounts": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            },
                            "description": "Container mounts, verbatim, after the script's."
                          },
                          "deadlineSeconds": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "The Job's activeDeadlineSeconds."
                          },
                          "ttlSecondsAfterFinished": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "name",
                          "serviceAccount",
                          "image",
                          "deadlineSeconds"
                        ],
                        "description": "A Job check: an AnalysisTemplate whose measurement is one Job, run once, decided by its exit code."
                      }
                    },
                    "analysisTemplates": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "Names of AnalysisTemplates that exist already, run beside the rest."
                    },
                    "metricsGate": {
                      "type": "boolean",
                      "description": "Run the built-in metrics gate (`metricsGate`) before the Stage's own checks."
                    }
                  }
                },
                "promotionTemplate": {
                  "type": "object",
                  "description": "The Stage's promotion template, verbatim; replaces the built-in git promotion."
                },
                "e2eApplication": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Argo CD Application that runs the product's end-to-end suite as a sync hook. The Stage's promotion ends with an `argocd-update` step that syncs it and waits, and a verification check reads the operation. The Application must carry `kargo.akuity.io/authorized-stage` for this Stage and is not listed in `applications`. Needs `promotedVersion.image` and `.jqImage`."
                }
              },
              "required": [
                "name"
              ]
            },
            "minItems": 1
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Annotations on the Project object alone, beside the chart-wide ones (for instance Kargo's `kargo.akuity.io/keep-namespace: \"true\"`, which makes deleting a Project leave its namespace and the Freight in it)."
          },
          "stageOrder": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Derive the Stages, in this order, from the promotion graph (`graph`) instead of spelling `stages` out."
          },
          "upstreams": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Replaces graph.upstreams for the Stages it names."
          },
          "autoPromote": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Derived Stages that promote on their own although they have an upstream."
          },
          "applications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The applications every derived Stage watches, through graph.applicationName; default the slug."
          },
          "applicationsByStage": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Replaces `applications` for the Stages it names."
          },
          "e2eStages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Derived Stages whose promotion runs the end-to-end Application."
          },
          "e2eApplication": {
            "type": "string",
            "minLength": 1,
            "description": "The end-to-end application, through graph.applicationName; default <slug>-e2e."
          },
          "metricsGateStages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Derived Stages that run the metrics gate."
          },
          "metricsGate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1,
                "description": "The workload's namespace; default the slug."
              },
              "release": {
                "type": "string",
                "minLength": 1,
                "description": "The workload's Helm release; default the slug."
              },
              "e2eJobRequired": {
                "type": "boolean",
                "description": "The version's own e2e Job must succeed (default true)."
              }
            },
            "description": "The project's metrics gate inputs."
          }
        },
        "required": [
          "name"
        ],
        "anyOf": [
          {
            "required": [
              "stages"
            ]
          },
          {
            "required": [
              "stageOrder"
            ]
          }
        ]
      }
    },
    "appProjects": {
      "type": "object",
      "description": "Argo CD AppProjects, by name, rendered in `argocd.namespace` beside the pipeline: the projects whose Applications the Stages watch. Each entry's `spec` is the AppProject spec verbatim. Neither the chart-wide `labels` nor `annotations` apply to them (those guard Kargo objects).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "spec": {
            "type": "object"
          }
        },
        "required": [
          "spec"
        ]
      }
    }
  }
}
