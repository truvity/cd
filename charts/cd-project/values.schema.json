{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "Generated by hack/company-schema.py; platform/product facts come from cd-delivery, pipeline settings from cd-pipeline.",
  "title": "cd-project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "clusters",
    "platformDigest"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "description": "Company-owned: the project, its charts, clusters and promotion order.",
      "required": [
        "name",
        "source",
        "clusters",
        "pipeline"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63,
          "description": "The project: the service name of its Applications, its Kargo Project, namespace and Warehouse."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chart",
            "semver"
          ],
          "properties": {
            "chart": {
              "type": "string",
              "minLength": 1,
              "description": "The application chart, oci://<repository>/<chart>: what the Warehouse subscribes to, and the repository and chart of every ring's Application (<chart>, <chart>-infra, <chart>-e2e)."
            },
            "infraChart": {
              "type": "string",
              "minLength": 1,
              "description": "The infra chart, released with the application chart and installed at its pin; must be <chart>-infra. Refused for a kind with no infra ring."
            },
            "semver": {
              "type": "string",
              "minLength": 1
            },
            "versionPrefix": {
              "type": "string",
              "description": "Written in front of the version in the pin, for a repository whose tags carry one."
            },
            "subscribeAs": {
              "type": "string",
              "enum": [
                "chart",
                "image"
              ],
              "description": "How the Warehouse discovers the chart. `chart` (default) is a chart subscription. `image` is an image subscription with SemVer selection and `strictSemvers: false`, for an OCI chart whose tags carry a `v` (Helm's tag listing drops them, so a chart subscription finds nothing). A leading `oci://` is dropped from `repoURL` for the subscription, the promotion steps write the discovered tag as it is (the `v` stays), and `name` and `versionPrefix` are refused."
            }
          }
        },
        "clusters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "minItems": 1,
          "description": "The clusters the project runs on; each one the platform registered (clusters)."
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stageOrder"
          ],
          "properties": {
            "stageOrder": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "minItems": 1,
              "description": "The Stages, in order; each one a cluster of project.clusters whose pin it writes."
            },
            "autoPromote": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "description": "Stages that promote on their own although they have an upstream."
            },
            "upstreams": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                  "maxLength": 63
                }
              },
              "description": "Replaces pipeline.graph.upstreams for the Stages it names."
            }
          }
        }
      }
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "infra": {
            "type": "object"
          },
          "app": {
            "type": "object"
          },
          "e2e": {
            "type": "object"
          }
        }
      },
      "description": "Company-owned ring payloads per cluster of project.clusters, held to cd-company's ownership rules."
    },
    "pins": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Company-owned (Kargo writes them): the version per cluster of project.clusters; an empty string is dormant."
    },
    "clusters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "minItems": 1,
      "description": "Platform-owned: the clusters the platform registered for this project."
    },
    "platform": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clusterName": {
            "type": "string",
            "minLength": 1,
            "description": "The destination cluster's name in Argo CD, and the {cluster} token in every template below."
          },
          "argocdNamespace": {
            "type": "string",
            "minLength": 1,
            "description": "The namespace the Applications are created in."
          },
          "applicationSuffixes": {
            "type": "object",
            "description": "The suffix of each ring's Application NAME (infra, app, e2e); default -infra, none, -e2e. The chart, repository and release keep their names.",
            "additionalProperties": false,
            "properties": {
              "infra": {
                "type": "string",
                "pattern": "^(-[a-z0-9]+)*$"
              },
              "app": {
                "type": "string",
                "pattern": "^(-[a-z0-9]+)*$"
              },
              "e2e": {
                "type": "string",
                "pattern": "^(-[a-z0-9]+)*$"
              }
            }
          },
          "applicationPrefix": {
            "type": "string",
            "description": "Prepended to every Application's name (empty is allowed)."
          },
          "appProject": {
            "type": "string",
            "minLength": 1,
            "description": "The AppProject every Application runs under, with {product} and {cluster} tokens."
          },
          "applicationLabels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Labels on every Application; values accept the {product} and {cluster} tokens."
          },
          "waves": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "infra": {
                "type": "integer"
              },
              "app": {
                "type": "integer"
              },
              "e2e": {
                "type": "integer"
              }
            },
            "required": [
              "infra",
              "app",
              "e2e"
            ],
            "description": "Deprecated and ignored: Applications carry no sync-wave. Accepted for one release so a consumer can drop it."
          },
          "chartRegistry": {
            "type": "string",
            "minLength": 1,
            "description": "Base reference the charts are published under, used for a product that names no repository of its own."
          },
          "tier": {
            "type": "string",
            "enum": [
              "primary",
              "test"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "single",
              "high"
            ],
            "description": "The cluster's redundancy, passed to the application chart as `availability` from delivery interface 14, which sizes its replicas and disruption budget from it. Unset: nothing is passed (the chart's default, single)."
          },
          "finalizer": {
            "type": "boolean",
            "description": "Add the Argo CD resources finalizer, so removing an Application removes what it deployed."
          },
          "sync": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "prune": {
                "type": "boolean"
              },
              "selfHeal": {
                "type": "boolean"
              },
              "serverSideApply": {
                "type": "boolean"
              },
              "createNamespace": {
                "type": "boolean"
              }
            }
          },
          "syncRetry": {
            "type": "object",
            "additionalProperties": false,
            "description": "Retry policy of every generated Application except the end-to-end one, which never retries. Defaults: no limit, refresh on each retry so it resolves the latest revision, backoff 15s doubling to 5m.",
            "properties": {
              "limit": {
                "type": "integer"
              },
              "refresh": {
                "type": "boolean"
              },
              "backoff": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "duration": {
                    "type": "string"
                  },
                  "factor": {
                    "type": "integer"
                  },
                  "maxDuration": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "cloud": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accountID": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "string",
                "minLength": 1
              },
              "permissionsBoundary": {
                "type": "string",
                "minLength": 1
              },
              "iamNameTemplate": {
                "type": "string",
                "minLength": 1,
                "description": "Name of a product's cloud role, with {cluster}, {slug} and {product} tokens. At most 64 characters once filled."
              },
              "bucketNameTemplate": {
                "type": "string",
                "minLength": 1,
                "description": "Name of a product's bucket, with the same tokens."
              }
            },
            "required": [
              "accountID",
              "region",
              "iamNameTemplate",
              "bucketNameTemplate"
            ],
            "description": "The cloud facts, needed by a product that has a bucketSlug."
          },
          "postgres": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instances": {
                "type": "integer",
                "minimum": 1
              },
              "storage": {
                "type": "string",
                "minLength": 1
              },
              "scheduling": {
                "type": "object"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Labels the database carries; values accept {product} and {cluster}."
              }
            },
            "required": [
              "instances",
              "storage"
            ]
          },
          "events": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "authAudience": {
                "type": "string",
                "minLength": 1
              },
              "storage": {
                "type": "string",
                "minLength": 1
              },
              "replicas": {
                "type": "integer",
                "minimum": 1
              },
              "maxAge": {
                "type": "string",
                "minLength": 1
              },
              "account": {
                "type": "string",
                "minLength": 1,
                "description": "The broker account of a product, with {product} and {cluster} tokens."
              },
              "tls": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "serverName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "caConfigMap": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "serverName",
                  "caConfigMap"
                ],
                "description": "Present only where the broker accepts a workload identity."
              }
            },
            "required": [
              "url",
              "storage",
              "replicas",
              "maxAge",
              "account"
            ]
          },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rootCA": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "configMapName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "configMapName",
                  "key"
                ]
              }
            },
            "description": "The root a database client verifies the server against."
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trustDomain": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "type": "string",
                "enum": [
                  "off",
                  "permissive",
                  "strict"
                ]
              },
              "grantRequest": {
                "type": "boolean"
              }
            },
            "required": [
              "trustDomain"
            ],
            "description": "Needed by a product with workloadIdentity."
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "endpoint": {
                "type": "string",
                "minLength": 1
              },
              "sampleRatio": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "e2e": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "full",
                  "tenant"
                ]
              },
              "proberInterval": {
                "type": "string",
                "minLength": 1
              },
              "traces": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tokenURL": {
                    "type": "string",
                    "minLength": 1
                  },
                  "client": {
                    "type": "string",
                    "minLength": 1
                  },
                  "audience": {
                    "type": "string",
                    "minLength": 1
                  },
                  "caConfigMap": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "url",
                  "tokenURL",
                  "client",
                  "audience",
                  "caConfigMap"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "alerts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ignoreDifferences": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "ignoreDifferences entries the application ring of every product whose alerts reach its chart (`alerts.enabled`, interface 12 or higher) gets first, for a rule kind whose live object carries server-side defaults the render does not."
              }
            },
            "description": "What the platform adds for a product's alert rules."
          },
          "dashboards": {
            "type": "object",
            "description": "Passed to the application ring as `observability.dashboards`, verbatim, for every product with `dashboards: true` (the folder and data sources of this cluster's dashboards). Unset: nothing is passed."
          },
          "staticSite": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "infraLabels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Labels the infrastructure Application of every `static-site` product gets, verbatim. Ordering that must hold between the two Applications of a site (a sync gate, say) is the platform's, and is handed through here; the chart names none. Unset: none."
              },
              "siteAnnotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Annotations the site Application of every `static-site` product gets, verbatim (a sync wave, say). Unset: none."
              }
            },
            "description": "What the platform adds to the Applications of a `static-site` product."
          }
        }
      },
      "description": "Platform-owned: cd-company's platform block, per cluster."
    },
    "products": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interface": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "description": "The highest delivery interface the pinned charts read (truvity/policy docs/contracts/delivery-interface.md)."
          },
          "hostname": {
            "type": "string",
            "minLength": 1
          },
          "parentRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "group",
              "kind",
              "name",
              "namespace"
            ],
            "description": "The route's parent, passed by name."
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "hostname": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "hostname"
              ]
            }
          },
          "bucketSlug": {
            "type": "string",
            "minLength": 1
          },
          "workloadIdentity": {
            "type": "boolean"
          },
          "natsIdentity": {
            "type": "boolean"
          },
          "mtls": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "strict": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "peers": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "namespace": {
                        "type": "string",
                        "minLength": 1
                      },
                      "serviceAccount": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "namespace",
                      "serviceAccount"
                    ]
                  }
                }
              }
            }
          },
          "postgres": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serverTLS": {
                "type": "boolean"
              },
              "platformOwned": {
                "type": "boolean"
              },
              "runtimeRole": {
                "type": "boolean",
                "description": "Defaults to true: the infra chart is handed postgres.runtimeRole, runtimePasswordSecret and runtimePassword.generate. Set false for an infra chart whose postgres schema does not have them; none of the three is sent. Refused at delivery interface 15 or higher, where the runtime role is not optional."
              },
              "migrations": {
                "type": "boolean",
                "description": "The product declares that it runs schema migrations. From delivery interface 15 the owner's credential is then passed to the application chart as database.migration.passwordSecret, for a migration Job or hook Job alone; the long-running workloads get database.app.* only, always. Unset: no owner credential is passed at 15 or higher. Refused below 15, where the owner credential is passed as database.owner.passwordSecret."
              },
              "backup": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "objectStoreName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serverName": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "objectStoreName",
                  "serverName"
                ]
              }
            }
          },
          "e2e": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "proberGranted": {
                "type": "boolean"
              },
              "peerComponents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "events": {
                "type": "object"
              },
              "kargoStage": {
                "type": "string",
                "minLength": 1,
                "description": "`<kargo project>:<stage>` that may sync the end-to-end Application. Rendered as the `kargo.akuity.io/authorized-stage` annotation on that Application only; omitted when unset."
              },
              "sync": {
                "type": "string",
                "enum": [
                  "auto",
                  "manual"
                ],
                "description": "`auto` (default): the end-to-end Application syncs by itself. `manual`: it renders without `syncPolicy.automated`, for a Kargo Stage that syncs it."
              },
              "hook": {
                "type": "boolean",
                "description": "Render the end-to-end suite's Job as an Argo CD Sync hook (hook-delete-policy BeforeHookCreation, sync-wave 1) instead of a tracked resource with Force and Replace. Default false."
              },
              "ttlSecondsAfterFinished": {
                "type": "integer",
                "minimum": 120,
                "description": "Seconds a finished hook Job is kept, when `hook` is true. Default 86400; the end-to-end chart refuses less than 120."
              }
            }
          },
          "faro": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "apiKey": {
                "type": "string",
                "minLength": 1
              },
              "sampleRate": {
                "type": "number"
              },
              "route": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ruleName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rewritePath": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requestBufferLimit": {
                    "type": "string",
                    "pattern": "^[0-9]+(Ki|Mi|Gi|k|M|G)?$"
                  },
                  "backend": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "namespace": {
                        "type": "string",
                        "minLength": 1
                      },
                      "port": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "name",
                      "namespace",
                      "port"
                    ]
                  }
                },
                "required": [
                  "ruleName",
                  "path",
                  "rewritePath",
                  "backend"
                ]
              }
            },
            "required": [
              "enabled"
            ]
          },
          "identityProviders": {
            "type": "object"
          },
          "alerts": {
            "type": "object",
            "description": "The product's alert values (enabled, remote, ruleLabels, alertLabels, one block of thresholds per rule), passed to the application chart verbatim from interface 12."
          },
          "access": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "issuer": {
                "type": "string",
                "minLength": 1
              },
              "audience": {
                "type": "string",
                "minLength": 1
              },
              "signOutUrl": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "issuer",
              "audience",
              "signOutUrl"
            ]
          },
          "product": {
            "type": "object"
          },
          "ignoreDifferences": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "infra": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "app": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "e2e": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "dashboards": {
            "type": "boolean",
            "description": "The product's chart renders dashboards: it is handed `platform.dashboards` as `observability.dashboards` where the platform states one."
          },
          "platformValues": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "infra": {
                "type": "object"
              },
              "app": {
                "type": "object"
              },
              "e2e": {
                "type": "object"
              }
            },
            "description": "The platform's own payload per ring, merged over what the chart composed and before `layers` and `values`. In `cd-company` it is platform-owned: a company cannot override a path it sets."
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "since"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The layer's name, unique in the product."
                },
                "since": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "description": "The first release whose chart reads these values, `x.y.z`. The layer applies when the product's `pin` (a leading `v` is ignored) is at or above it, counting a prerelease of it (`>=since-0`); a pin that is not a version turns it off."
                },
                "required": {
                  "type": "boolean",
                  "description": "With `true`, a pin below `since` is a render failure instead of a silent skip."
                },
                "values": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "infra": {
                      "type": "object"
                    },
                    "app": {
                      "type": "object"
                    },
                    "e2e": {
                      "type": "object"
                    }
                  },
                  "description": "Merged like `platformValues`, when the layer's pin gate is open."
                }
              }
            },
            "description": "Ordered, pin-gated payloads owned by the platform: a chart's closed schema rejects a key an older release does not read, and the pin moves without the platform rendering anything, so the comparison is made here. Merged after `platformValues` in list order, before `values`."
          },
          "kind": {
            "type": "string",
            "enum": [
              "product",
              "chart",
              "static-site"
            ],
            "description": "`product` (default): the three-ring product. `chart`: one chart, one Application named after the product, no rings, no composed platform facts; takes only `pin`, `repository`, `chart`, `namespace` and `values.app`. A `repository` that starts with `oci://` renders `repoURL: <repository>/<chart>`; any other renders `repoURL: <repository>` with `chart: <chart>`. `static-site`: two Applications, `<name>-infra` and `<name>`, of the same chart release, pinned by the digest of the site artifact; takes `pin` (a `sha256:` digest), `chartVersion`, `artifact.ref`, `repository`, `namespace`, `values.{infra,app}` and `platformValues.{infra,app}`."
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "description": "Kinds `chart` and `static-site` only: the destination namespace (default the product's name)."
          },
          "chartVersion": {
            "type": "string",
            "minLength": 1,
            "description": "Kind `static-site` only: the release of the `static-site` and `static-site-infra` charts, the targetRevision of both Applications."
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "description": "The repository of the site artifact, without a tag or digest. The chart is given this and `pin`."
              }
            },
            "description": "Kind `static-site` only: the site artifact."
          }
        },
        "required": [],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "chart",
                    "static-site"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "else": {
              "required": [
                "interface",
                "hostname"
              ]
            }
          }
        ]
      },
      "description": "Platform-owned: the project's product facts, per cluster (cd-company's products.<service>)."
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "description": "Platform-owned: the allowlisted cd-pipeline settings. No credentials, verification, access, Project or AppProjects.",
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels on every object. None by default: the chart adds nothing the values do not say."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations on every object, beside the sync-wave. None by default."
        },
        "waves": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "integer"
            },
            "warehouse": {
              "type": "integer"
            },
            "credentials": {
              "type": "integer"
            },
            "config": {
              "type": "integer"
            },
            "stage": {
              "type": "integer"
            }
          },
          "description": "The Argo CD sync-wave of each kind of object."
        },
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "description": "Where the Argo CD Applications of the Stages live."
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repoURL": {
              "type": "string",
              "minLength": 1,
              "description": "The repository a promotion writes the pin to."
            }
          },
          "description": "The repository a promotion writes the pin to. The write-back credentials are the platform's and are not rendered here."
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "pinFile": {
              "type": "string",
              "minLength": 1,
              "description": "The file the pin is written to, relative to the repository; tokens {stage}, {project}, {slug}, {pinKey}."
            },
            "pinKey": {
              "type": "string",
              "minLength": 1,
              "description": "The key written in it; the same tokens."
            },
            "commitMessage": {
              "type": "string",
              "minLength": 1,
              "description": "The same tokens and {version}, the Kargo expression for the promoted version."
            },
            "prTitle": {
              "type": "string",
              "minLength": 1,
              "description": "The same tokens."
            },
            "prLabels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "errorThreshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeout": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^([0-9]+h[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]s)$"
                }
              }
            },
            "gate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "timeout": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^([0-9]+h[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]m[0-5]?[0-9]s|[0-5]?[0-9]s)$"
                }
              }
            }
          }
        },
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttlSecondsAfterFinished": {
              "type": "integer",
              "minimum": 0
            },
            "headroomSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "runAsUser": {
              "type": "integer",
              "minimum": 0
            },
            "runAsGroup": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "What every verification Job is run as."
        },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upstreams": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Stage -> the Stages it may promote from, in preference; the first the project has wins."
            },
            "applicationName": {
              "type": "string",
              "minLength": 1,
              "description": "The Argo CD Application a derived Stage watches; tokens {stage}, {app}."
            }
          },
          "description": "The promotion graph: derived Stages never run the promoted-version check and get no access subjects here."
        }
      }
    },
    "platformDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Platform-owned: sha256 of toJson of {clusters, pipeline, platform, products} as the platform passes them."
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "description": "Helm's own: a parent chart's global values reach every subchart. The chart reads none of it."
    },
    "cd-company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": {}
        },
        "products": {
          "const": {}
        },
        "services": {
          "const": []
        },
        "pins": {
          "const": {}
        },
        "values": {
          "const": {}
        },
        "global": {
          "$ref": "#/properties/global"
        },
        "cd-delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {
              "const": {
                "tier": "primary",
                "finalizer": true,
                "sync": {
                  "prune": true,
                  "selfHeal": true,
                  "serverSideApply": true,
                  "createNamespace": false
                },
                "syncRetry": {
                  "limit": -1,
                  "refresh": true,
                  "backoff": {
                    "duration": "15s",
                    "factor": 2,
                    "maxDuration": "5m"
                  }
                }
              }
            },
            "products": {
              "const": {}
            },
            "global": {
              "$ref": "#/properties/global"
            }
          }
        }
      }
    },
    "cd-pipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "const": {}
        },
        "annotations": {
          "const": {}
        },
        "waves": {
          "const": {
            "project": 0,
            "warehouse": 1,
            "credentials": 2,
            "config": 3,
            "stage": 4
          }
        },
        "argocd": {
          "const": {
            "namespace": "argocd"
          }
        },
        "git": {
          "const": {}
        },
        "promotion": {
          "const": {
            "branch": "main",
            "pinFile": "versions/{stage}.yaml",
            "pinKey": "{pinKey}",
            "commitMessage": "chore: promote {slug} {version} to {stage}",
            "prTitle": "chore: promote {slug} to {stage}",
            "prLabels": [],
            "provider": "github",
            "retry": {
              "errorThreshold": 3,
              "timeout": "5m0s"
            },
            "gate": {
              "timeout": "10m0s"
            }
          }
        },
        "jobs": {
          "const": {
            "ttlSecondsAfterFinished": 21600,
            "headroomSeconds": 120,
            "runAsUser": 65532,
            "runAsGroup": 65532
          }
        },
        "promotedVersion": {
          "const": {
            "waitSeconds": 1500,
            "pollSeconds": 15,
            "gateImage": ""
          }
        },
        "metricsGate": {
          "const": {
            "gateImage": "",
            "image": "",
            "jqImage": "",
            "serviceAccount": "metrics-gate-{stage}",
            "issuerHost": "",
            "endpoints": {},
            "token": {
              "audience": "",
              "expirationSeconds": 3600,
              "volumeName": "issuer-token",
              "mountPath": "/var/run/secrets/tokens/issuer"
            },
            "caBundle": {
              "configMap": "",
              "key": "ca-certificates.crt",
              "volumeName": "ca-bundle",
              "mountPath": "/etc/ssl/metrics-ca"
            },
            "phase1Seconds": 1500,
            "bakeSeconds": 480,
            "scrapeLagSeconds": 30,
            "pollSeconds": 30,
            "minJourneys": 10,
            "maxFailureRatio": 0.05,
            "checkFiringAlerts": true,
            "proberJourneyMetric": "probe_journey_total"
          }
        },
        "graph": {
          "const": {
            "upstreams": {},
            "applicationName": "{stage}-{app}",
            "promotedVersion": false,
            "approvers": {
              "subject": "approver-{stage}",
              "claims": {}
            },
            "admins": {
              "subject": "admin",
              "claims": {}
            }
          }
        },
        "viewer": {
          "const": {}
        },
        "projects": {
          "const": []
        },
        "appProjects": {
          "const": {}
        },
        "global": {
          "$ref": "#/properties/global"
        }
      }
    }
  }
}
